# ==========================================
# 1. DATABASE CONNECTION (PostgreSQL / Supabase)
# ==========================================
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ==========================================
# 2. AUTENTIKASI & KEAMANAN SESI
# ==========================================
# String acak minimal 32 karakter (buat via: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-random-key-min-32-chars-long"
NODE_ENV="development"

# ==========================================
# 3. PENYIMPANAN CLOUD STORAGE (MEDIA ASSETS)
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==========================================
# 4. SMTP MAIL SERVICE (RESET PASSWORD)
# ==========================================
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Creatify Admin <noreply@creatify.fasilkom.ac.id>"

# ==========================================
# 5. DOMAIN & URL APLIKASI
# ==========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
